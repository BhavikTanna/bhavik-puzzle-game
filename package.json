{
  "name": "bhavik-puzzle-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "infra"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check": "yarn lint && yarn test && yarn build",
    "infra:typecheck": "yarn workspace brickwords-infra run typecheck",
    "infra:bootstrap": "yarn workspace brickwords-infra run bootstrap",
    "synth": "yarn build && yarn workspace brickwords-infra run synth",
    "diff": "yarn build && yarn workspace brickwords-infra run diff",
    "deploy": "yarn build && yarn workspace brickwords-infra run deploy",
    "destroy": "yarn workspace brickwords-infra run destroy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
